      "id": "f6b8d0e2-4a5c-4d9e-1f3a-6b7c8d9e0f12",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        448,
        112
      ],
