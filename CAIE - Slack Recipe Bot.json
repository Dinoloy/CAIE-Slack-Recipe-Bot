    {
      "parameters": {
        "jsCode": "// Format the AI response neatly for Slack (mrkdwn)\nconst raw = ($json.text || '').trim();\nconst channel = $('Edit Fields').item.json.channel;\nconst recipe = $('Edit Fields').item.json.recipe;\n\nlet text;\n\nif (!raw) {\n  text = `Sorry, I couldn't work out the ingredients for \"${recipe}\". Please try again with a dish name, e.g. *Paneer Butter Masala*.`;\n} else if (/^UNCLEAR:/i.test(raw)) {\n  text = ':thinking_face: ' + raw.replace(/^UNCLEAR:\\s*/i, '');\n} else {\n  const lines = raw\n    .replace(/\\r\\n/g, '\\n')\n    .replace(/\\*\\*(.+?)\\*\\*/g, '*$1*')        // markdown bold -> Slack bold\n    .split('\\n')\n    .map(l => l.trim())\n    .filter(Boolean)\n    .map(l => l.replace(/^([-*\\u2022]|\\d+[.)])\\s+/, '\\u2022 ')); // bullets -> •\n\n  // Bold the heading line\n  if (lines.length && !lines[0].startsWith('\\u2022')) {\n    lines[0] = ':shopping_trolley: *' + lines[0].replace(/\\*/g, '') + '*';\n  }\n  text = lines.join('\\n');\n}\n\nreturn [{ json: { channel, text } }];"
      },
      "id": "a7c9e1f3-5b6d-4e0f-2a4b-7c8d9e0f1a23",
      "name": "Format for Slack",
